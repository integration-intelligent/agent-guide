# 复制到 /etc/xiaodazi.env 后在服务器本地编辑；不要提交真实凭据。
FEISHU_APP_ID=cli_replace_me
FEISHU_APP_SECRET=replace_me
FEISHU_OWNER_OPEN_ID=ou_replace_me
# 模型配置选择一组。以下默认使用 DeepSeek。
AGENT_PROVIDER=deepseek
DEEPSEEK_API_KEY=replace_me
# 共用变量名，填写所选服务商的模型 ID。
OPENAI_MODEL=deepseek-flash

# 若选择 OpenAI，用以下三行替换上面的模型配置（不要同时启用两组）。
# AGENT_PROVIDER=openai
# OPENAI_API_KEY=replace_me
# OPENAI_MODEL=replace_with_available_model_id
# 模型配置只影响小搭子，不影响 Codex；服务启动时由 EnvironmentFile 读取。
